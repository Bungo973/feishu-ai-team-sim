# 复制为 .env 再填写。.env 不会被提交到 git。

# 「AI 进度助手」这个飞书应用（企业自建应用，开机器人能力；权限见 README）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 项目多维表格的链接（带 ?table= 的那张就是任务表）
FEISHU_BITABLE_URL=
# 表名不一样时改这里（任务表以链接里的 ?table= 为准）
# TASK_TABLE=任务进度
# REPORT_TABLE=日报

# 大模型（OpenAI 兼容接口，需要支持工具调用 / function calling）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 模拟时钟（模拟器写，助手只读）。不和模拟器一起用时可以不管
CLOCK_FILE=../shared/clock.jsonl

# 这些发送者的消息不读：游戏后台（导演）
IGNORE_SENDERS=导演
# 代发机器人：真正的发送人写在正文开头"名字：……"
PROXY_SENDERS=其他同事
