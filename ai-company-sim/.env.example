# 复制本文件为 .env，再填写。.env 不会被提交到 git。

# ---- 必填：大模型接口（任何 OpenAI 兼容接口都可以）
LLM_PROVIDER=openai
LLM_API_KEY=
# DeepSeek（默认）：https://api.deepseek.com
# 其他常见平台（地址以平台文档为准）：通义千问 https://dashscope.aliyuncs.com/compatible-mode/v1 ；
#   Kimi https://api.moonshot.cn/v1 ；智谱 https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=https://api.deepseek.com

# 模型名（换平台时一定要改成该平台的模型名）
# 导演：写剧本、评估你的动作、结局报告（要求最高）。觉得评估不够严谨可以试 deepseek-reasoner
MODEL_DIRECTOR=deepseek-chat
# 演员：群消息、私聊、日报、会议实录
MODEL_ACTOR=deepseek-chat
# 单次输出上限（DeepSeek 最大 8000 左右；别的平台可以调大）
LLM_MAX_TOKENS=8000

# 如果以后用 Claude：LLM_PROVIDER=anthropic，填 ANTHROPIC_API_KEY，模型名改成 claude-opus-5-5 / claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# ---- 测试用：offline = 不调用 AI，用占位文字跑通流程
# LLM_MODE=offline

# ==== 飞书模式（推荐）：整局在飞书里玩，见 docs/飞书配置指南.md ====
# 每个机器人是一个"企业自建应用"，填 App ID 和 App Secret。导演必填，其余没填的同事由"其他同事"代发（消息前带名字）。
FEISHU_BOT_DIRECTOR_ID=
FEISHU_BOT_DIRECTOR_SECRET=
FEISHU_BOT_WANGLI_ID=
FEISHU_BOT_WANGLI_SECRET=
FEISHU_BOT_ZHANGWEI_ID=
FEISHU_BOT_ZHANGWEI_SECRET=
FEISHU_BOT_LIXIANG_ID=
FEISHU_BOT_LIXIANG_SECRET=
FEISHU_BOT_CHENYUE_ID=
FEISHU_BOT_CHENYUE_SECRET=
FEISHU_BOT_ZHOUTAO_ID=
FEISHU_BOT_ZHOUTAO_SECRET=
FEISHU_BOT_OTHERS_ID=
FEISHU_BOT_OTHERS_SECRET=
# 可选：孙磊 / 刘敏 / 黄建国 也可以各建一个
# FEISHU_BOT_SUNLEI_ID=
# FEISHU_BOT_SUNLEI_SECRET=
# FEISHU_BOT_LIUMIN_ID=
# FEISHU_BOT_LIUMIN_SECRET=
# FEISHU_BOT_HUANG_ID=
# FEISHU_BOT_HUANG_SECRET=

# 任务表（多维表格）的链接：打开表格，复制浏览器地址栏，要带 ?table=tbl…
FEISHU_BITABLE_URL=
# 模拟时间速度：现实 1 分钟 = 模拟几分钟（15 → 上午约 12 分钟）。玩的时候也可以给导演发"速度 20"
FEISHU_SPEED=15

# ==== 下面是旧的"机器人只发不收"模式（终端玩法用）。飞书模式不需要，FEISHU_SEND 保持 off ====
# ---- 飞书机器人模式（README 第 3 步）
# auto = 每次 start / end 之后自动把消息发到飞书；off = 手动用 uv run sim send
FEISHU_SEND=off

# 每个群至少配一个 DEFAULT 机器人（消息前会自动加"王丽："这样的名字）
FEISHU_WEBHOOK_TEAM_DEFAULT=
FEISHU_SECRET_TEAM_DEFAULT=
FEISHU_WEBHOOK_LAUNCH_DEFAULT=
FEISHU_SECRET_LAUNCH_DEFAULT=

# 想让每个同事有自己的头像和名字：给每人建一个机器人，填下面这些（没填的人会用 DEFAULT）
# TEAM = 群「品牌项目组」；LAUNCH = 群「小暖 S2 发布会筹备」
# 角色拼音：WANGLI 王丽 / ZHANGWEI 张伟 / LIXIANG 李想 / CHENYUE 陈悦 / HUANG 黄建国 / ZHOUTAO 周涛 / SUNLEI 孙磊
# FEISHU_WEBHOOK_TEAM_WANGLI=
# FEISHU_SECRET_TEAM_WANGLI=
# FEISHU_WEBHOOK_LAUNCH_ZHOUTAO=
# FEISHU_SECRET_LAUNCH_ZHOUTAO=
# ……以此类推

# 让机器人 @你：填你的飞书用户 ID（管理后台 → 成员与部门 → 点你的名字 → 用户 ID）【需实测】
FEISHU_PLAYER_ID=

# ---- 进阶：自动采集你在群里的发言（README 第 5 步）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_TEAM=
FEISHU_CHAT_LAUNCH=
